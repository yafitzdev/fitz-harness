# The host binds to loopback by default. Do not expose it publicly.
FITZ_HOST=127.0.0.1
FITZ_PORT=8787
FITZ_DATABASE_PATH=./data/fitz.db

# fake is the safe development default. ninfer is opt-in and intended to run inside WSL.
FITZ_ENGINE_MODE=fake

# When set, management endpoints require this value in x-fitz-admin-token.
FITZ_ADMIN_TOKEN=
