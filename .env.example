# The host binds to loopback by default. Do not expose it publicly.
FITZ_HOST=127.0.0.1
FITZ_PORT=8787
FITZ_DATABASE_PATH=./data/fitz-ninfer.db

# NiNfer is the application default. Use pnpm dev:fake for deterministic UI testing.
FITZ_ENGINE_MODE=ninfer
FITZ_RESERVE_VRAM_MIB=2048

# NiNfer is run directly on Linux and through WSL when the host runs on Windows.
FITZ_NINFER_WSL_DISTRIBUTION=Ubuntu
FITZ_NINFER_WSL_USER=root

# When set, management endpoints require this value in x-fitz-admin-token.
FITZ_ADMIN_TOKEN=
