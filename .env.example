# The host binds to loopback by default. Do not expose it publicly.
FITZ_HOST=127.0.0.1
FITZ_PORT=8787

# One repo-contained data root for development: sessions, pi packages, logs, cache.
# The packaged app keeps its own per-user data root (%LOCALAPPDATA%\Fitz Codex).
# Run `pnpm migrate:dev-data` once to move an existing data/fitz-ninfer.db into it.
FITZ_DATA_ROOT=./data

# NiNfer is the application default. Use pnpm dev:fake for deterministic UI testing.
FITZ_ENGINE_MODE=ninfer
FITZ_RESERVE_VRAM_MIB=2048

10→# NiNfer is run directly on Linux and through WSL when the host runs on Windows.
FITZ_NINFER_WSL_DISTRIBUTION=Ubuntu
FITZ_NINFER_WSL_USER=root

# Desktop chat runs through Pi's coding-agent loop by default. Set direct only for raw completion diagnostics.
FITZ_AGENT_RUNTIME=pi
# Optional overrides; normal desktop use derives the working folder from the selected project.
FITZ_AGENT_BASE_URL=http://127.0.0.1:8787/v1
# FITZ_AGENT_CWD=C:\path\to\fixed\working\directory

20→# Narrow overrides. Normal use derives these from FITZ_DATA_ROOT and FITZ_LLM_ROOT.
# FITZ_DATABASE_PATH=C:\path\to\fitz.db
# FITZ_PI_AGENT_DIR=C:\path\to\pi
# FITZ_LOGS_DIR=C:\path\to\logs
# FITZ_CACHE_DIR=C:\path\to\cache
# FITZ_LLM_ROOT=C:\Users\me\.llm

# When set, management endpoints require this value in x-fitz-admin-token.
FITZ_ADMIN_TOKEN=
