{
  "name": "fitz-codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "node scripts/dev-ninfer.mjs",
    "dev:ninfer": "node scripts/dev-ninfer.mjs",
    "dev:fake": "node scripts/dev-fake.mjs",
    "start": "pnpm --filter @fitz/host start",
    "smoke": "pnpm build && node scripts/smoke-host.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test",
    "desktop:pack:win": "pnpm host:pack:win && pnpm --filter @fitz/desktop pack:win",
    "desktop:dist:win": "pnpm host:pack:win && pnpm --filter @fitz/desktop dist:win",
    "host:pack:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/package-host.ps1"
    ,"host:smoke:packaged": "node scripts/smoke-packaged-host.mjs"
    ,"desktop:smoke:packaged": "node scripts/smoke-packaged-desktop.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
