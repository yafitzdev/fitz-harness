# Repository allowlist
#
# Everything is ignored unless it is an explicitly supported project file.
# Directories must be opened separately so Git can reach allowed descendants.

*

# Root metadata and project configuration
!/.editorconfig
!/.env.example
!/.gitattributes
!/.gitignore
!/.nvmrc
!/CHANGELOG.md
!/CONTRIBUTING.md
!/DESIGN.md
!/LICENSE
!/LICENSE.*
!/README.md
!/SECURITY.md
!/TODO.html
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.base.json
!/tsconfig.json
!/vitest.config.ts

# GitHub configuration
!/.github/
!/.github/**/
!/.github/**/*.md
!/.github/**/*.yml
!/.github/**/*.yaml

# Applications
!/apps/
!/apps/*/
!/apps/*/package.json
!/apps/*/tsconfig.json
!/apps/*/scripts/
!/apps/*/scripts/**/*.cjs
!/apps/*/scripts/**/*.mjs
!/apps/*/scripts/**/*.ts
!/apps/*/src/
!/apps/*/src/**/
!/apps/*/src/**/*.cjs
!/apps/*/src/**/*.css
!/apps/*/src/**/*.html
!/apps/*/src/**/*.js
!/apps/*/src/**/*.json
!/apps/*/src/**/*.mjs
!/apps/*/src/**/*.png
!/apps/*/src/**/*.svg
!/apps/*/src/**/*.ts
!/apps/*/src/**/*.tsx
!/apps/*/src/**/*.webp

# Workspace packages
!/packages/
!/packages/*/
!/packages/*/package.json
!/packages/*/tsconfig.json
!/packages/*/src/
!/packages/*/src/**/
!/packages/*/src/**/*.json
!/packages/*/src/**/*.mjs
!/packages/*/src/**/*.ts
!/packages/*/src/**/*.tsx

# Documentation
!/docs/
!/docs/**/
!/docs/**/*.html
!/docs/**/*.jpeg
!/docs/**/*.jpg
!/docs/**/*.json
!/docs/**/*.md
!/docs/**/*.png
!/docs/**/*.svg
!/docs/**/*.webp

# Test fixtures and checked-in sample files
!/fixtures/
!/fixtures/**/
!/fixtures/**/*.json
!/fixtures/**/*.mjs
!/fixtures/**/*.ts
!/sample-files/
!/sample-files/**/*.csv
!/sample-files/**/*.html
!/sample-files/**/*.json
!/sample-files/**/*.md
!/sample-files/**/*.pdf
!/sample-files/**/*.png
!/sample-files/**/*.py
!/sample-files/**/*.svg
!/sample-files/**/*.tsx
!/sample-files/**/*.txt
!/sample-files/**/*.yaml

# Brand source assets
!/brand/
!/brand/**/
!/brand/**/*.jpeg
!/brand/**/*.jpg
!/brand/**/*.png
!/brand/**/*.svg
!/brand/**/*.webp

# Maintained development, validation, smoke, and packaging scripts
!/scripts/
!/scripts/**/
!/scripts/**/*.cjs
!/scripts/**/*.mjs
!/scripts/**/*.ps1
!/scripts/**/*.ts

# Local agent instruction files are intentionally never published.
**/[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
**/[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
