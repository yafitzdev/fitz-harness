{
  "name": "@fitz/desktop", "version": "0.0.0", "description": "Fitz Codex local-first agent desktop", "author": "Fitz Codex", "private": true, "type": "module", "main": "dist/bootstrap.cjs",
  "scripts": { "build": "tsc -b && node scripts/copy-static.mjs", "typecheck": "tsc -b --pretty false", "start": "pnpm build && electron .", "pack:win": "pnpm build && electron-builder --win dir --publish never", "dist:win": "pnpm build && electron-builder --win nsis --publish never", "dist:win:publish": "pnpm build && electron-builder --win nsis --publish always" },
  "dependencies": { "@fitz/connectivity": "workspace:*", "@fitz/media": "workspace:*", "@fitz/protocol": "workspace:*", "electron-updater": "6.8.9", "highlight.js": "^11.11.1", "katex": "^0.18.7", "mermaid": "^11.17.2" },
  "devDependencies": { "electron": "43.2.0", "electron-builder": "26.15.3", "esbuild": "^0.25.0" },
  "build": { "appId": "dev.yafitz.fitzcodex", "productName": "Fitz Codex", "asar": true, "files": ["dist/**/*", "package.json"], "extraResources": [
      { "from": "../../release/Fitz-Codex-Host.asar", "to": "host.asar" },
      { "from": "../../scripts/windows/desktop-host-start.ps1", "to": "start-host.ps1" }
  ], "directories": { "output": "release" }, "artifactName": "Fitz-Codex-${version}-${arch}.${ext}", "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] }, "nsis": { "oneClick": false, "perMachine": false, "allowElevation": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }, "publish": { "provider": "github", "owner": "yafitzdev", "repo": "fitz-codex", "releaseType": "release" } }
}
